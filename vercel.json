{
  "headers": [
    {
      "source": "/sp-data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/pixelface/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "spoonplatoon.vercel.app"
        }
      ],
      "destination": "/ironflag.html"
    },
    {
      "source": "/",
      "destination": "/api/index"
    },
    {
      "source": "/index.html",
      "destination": "/api/index"
    }
  ]
}
